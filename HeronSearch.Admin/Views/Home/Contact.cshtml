@* Public Contact page: how to reach the lost & found office, on the student layout. *@
@{
    ViewData["Title"] = "Contact";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>Contact</h1>
        <p>Reach the lost &amp; found office.</p>
    </div>

    <section class="dash-section">
        <div class="hs-card">
            <p>For questions about a report or a claim, visit the Lost &amp; Found office at the Main Lobby during campus hours.</p>
            <p class="mb-0">You can also email the office at lostandfound@umak.edu.ph and include your claim number if you have one.</p>
        </div>
    </section>
</div>
