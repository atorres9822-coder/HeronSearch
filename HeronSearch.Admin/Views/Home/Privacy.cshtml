@* Public Privacy Policy page: a plain-language summary of what data HeronSearch keeps and why, on the student layout. *@
@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>Privacy Policy</h1>
        <p>How we handle your information.</p>
    </div>

    <section class="dash-section">
        <div class="hs-card">
            <p>HeronSearch stores only the information needed to run the campus lost &amp; found: your name, email, optional student ID, the items you report, and the claims you file.</p>
            <p>Your email is used to contact you about your claims. Item listings are visible to the campus community so owners can be found.</p>
            <p class="mb-0">We do not sell your information. Accounts and records are managed by University of Makati staff.</p>
        </div>
    </section>
</div>
