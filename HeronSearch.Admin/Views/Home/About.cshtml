@* Public About page: a short description of HeronSearch and what it does, on the student layout. *@
@{
    ViewData["Title"] = "About";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>About HeronSearch</h1>
        <p>The campus lost &amp; found, in one place.</p>
    </div>

    <section class="dash-section">
        <div class="hs-card">
            <p>
                HeronSearch is the University of Makati's Lost &amp; Found platform. Students report items they have
                lost or found, search the public listings, and file ownership claims. Staff register found items and
                review claims so items get back to their rightful owners.
            </p>
            <p class="mb-0">A project of AnagolayCorp, University of Makati.</p>
        </div>
    </section>
</div>
