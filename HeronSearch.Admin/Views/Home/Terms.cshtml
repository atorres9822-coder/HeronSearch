@* Public Terms of Service page: the basic rules for using HeronSearch, on the student layout. *@
@{
    ViewData["Title"] = "Terms of Service";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>Terms of Service</h1>
        <p>The rules for using HeronSearch.</p>
    </div>

    <section class="dash-section">
        <div class="hs-card">
            <p>By using HeronSearch you agree to post accurate reports, file honest ownership claims, and respect other members of the campus community.</p>
            <p>Filing a false claim or misusing the platform may lead to your account being suspended.</p>
            <p class="mb-0">HeronSearch is provided for the University of Makati community as-is, to help return lost items to their owners.</p>
        </div>
    </section>
</div>
