@* Public landing page: hero and three feature cards, mirroring the student source landing.html layout. *@
@{
    ViewData["Title"] = "Welcome";
    Layout = "_StudentLayout";
}
<section class="hero">
    <h1>Welcome to HeronSearch</h1>
    <p>The community platform that connects people who have lost items with those who have found them.</p>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create Account</a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Log in</a>
</section>

<section class="features">
    <div class="feature">
        <svg class="student-icon" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg>
        <h3>Report Lost Items</h3>
        <p>Quickly report your lost items with details and images to increase your chances of finding them.</p>
    </div>
    <div class="feature">
        <svg class="student-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <h3>Find Items</h3>
        <p>Search for items by category, location, and date.</p>
    </div>
    <div class="feature">
        <svg class="student-icon" viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <h3>Verification System</h3>
        <p>Ensures that items are returned to their rightful owners.</p>
    </div>
</section>
