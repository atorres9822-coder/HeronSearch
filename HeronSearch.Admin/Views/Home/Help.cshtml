@* Public Help page: short answers to the most common how-to questions, on the student layout. *@
@{
    ViewData["Title"] = "Help";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>Help</h1>
        <p>How to use HeronSearch.</p>
    </div>

    <section class="dash-section">
        <div class="hs-card">
            <h2 class="h6">Report a lost or found item</h2>
            <p>Sign in, then use Report Lost or Report Found from the menu. Add a clear name, category, location, and a photo if you have one.</p>

            <h2 class="h6">Search the listings</h2>
            <p>Open Search to browse every active item, or filter by category. You do not need an account to browse.</p>

            <h2 class="h6">Claim an item</h2>
            <p>Open a found item's details and choose Claim this item. Describe why it is yours; staff review every claim before release.</p>

            <h2 class="h6 mb-0">Track your claims</h2>
            <p class="mb-0">My Claims shows the status of each claim, and Notifications tells you when a claim is approved or rejected.</p>
        </div>
    </section>
</div>
