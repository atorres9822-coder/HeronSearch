@* Change role modal, rendered once by the Manage Users list. site.js fills the hidden user Id, points the
   form at /Users/ChangeRole, and preselects the clicked row's current role when the modal opens (Req 21.4). *@
@{
    // The default returnUrl: the current path and query, so the list keeps its filters and page after the change.
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString;
}
<div class="modal fade" id="changeRoleModal" tabindex="-1" aria-labelledby="changeRoleTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="changeRoleForm" asp-controller="Users" asp-action="ChangeRole">
                <input type="hidden" name="Id" id="changeRoleUserId" value="0" />
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="changeRoleTitle">Change role</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label for="changeRoleSelect" class="form-label">Role</label>
                    <select class="form-select" id="changeRoleSelect" name="Role">
                        @foreach (var roleName in Enum.GetNames<HeronSearch.Admin.Models.UserRole>())
                        {
                            <option value="@roleName">@roleName</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Change role</button>
                </div>
            </form>
        </div>
    </div>
</div>
