@* Manage Claims list: the Pending/Approved/Rejected tabs with count badges, a table of the active tab's
   claims (Claim #, Item, Claimant, Date Filed, Status, Action), an empty state, and the pager (Req 18.1, 18.2). *@
@model ClaimListViewModel
@{
    ViewData["Title"] = "Manage Claims";

    // The three tabs and their counts, in display order; the active tab gets aria-current="page".
    var tabs = new (string Name, int Count)[]
    {
        (nameof(ClaimStatus.Pending), Model.PendingCount),
        (nameof(ClaimStatus.Approved), Model.ApprovedCount),
        (nameof(ClaimStatus.Rejected), Model.RejectedCount)
    };
}

<div class="hs-page-header">
    <h1 class="hs-page-title">Manage Claims</h1>
</div>

@* Tabs with count badges; each is a GET link that switches the tab. *@
<ul class="nav nav-pills hs-tabs mb-4" role="tablist">
    @foreach (var tab in tabs)
    {
        var isActive = Model.Tab == tab.Name;
        <li class="nav-item" role="presentation">
            <a class="nav-link @(isActive ? "active" : null)"
               asp-controller="Claims" asp-action="Index" asp-route-tab="@tab.Name"
               aria-current="@(isActive ? "page" : null)">
                @tab.Name <span class="badge rounded-pill text-bg-light ms-1">@tab.Count</span>
            </a>
        </li>
    }
</ul>

@if (Model.Rows.Count == 0)
{
    <div class="hs-card">
        <partial name="_EmptyState" model="@(("bi-clipboard-check", $"No {Model.Tab} claims.", (string?)null, (string?)null))" />
    </div>
}
else
{
    <div class="hs-card">
        <div class="table-responsive">
            <table class="table hs-table">
                <thead>
                    <tr>
                        <th scope="col">Claim #</th>
                        <th scope="col">Item</th>
                        <th scope="col">Claimant</th>
                        <th scope="col">Date Filed</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>#@row.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <partial name="_ItemPhoto" model="@((row.ItemImagePath, row.ItemCategory, "sm"))" />
                                    <span>@row.ItemName</span>
                                </div>
                            </td>
                            <td>
                                <div>@row.ClaimantName</div>
                                <div class="text-body-secondary small">@(string.IsNullOrWhiteSpace(row.ClaimantStudentId) ? "—" : row.ClaimantStudentId)</div>
                            </td>
                            <td>@DisplayFormat.ShortDate(row.DateFiled)</td>
                            <td><partial name="_StatusBadge" model="@row.Status.ToString()" /></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Claims" asp-action="Review" asp-route-id="@row.Id">
                                    @(row.Status == ClaimStatus.Pending ? "Review" : "View")<span class="visually-hidden"> claim #@row.Id</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <partial name="_Pager" model="Model.Pager" />
        </div>
    </div>
}
