@* Add Found Item page: the Create form posting multipart data to Items/Create (with the automatic
   anti-forgery token), the shared field partial, and a Save/Cancel pair (Req 14.1, 7.1, 7.5, 7.6, 10.6). *@
@model ItemFormViewModel
@{
    ViewData["Title"] = "Add Found Item";
}

<div class="hs-page-header">
    <h1 class="hs-page-title">Add Found Item</h1>
</div>

<div class="hs-card">
    <form asp-controller="Items" asp-action="Create" method="post" enctype="multipart/form-data">
        @* Model-level errors (for example a photo that could not be saved) show above the fields. *@
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <partial name="_ItemFormFields" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save Item</button>
            <a class="btn btn-outline-secondary" asp-controller="Items" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
