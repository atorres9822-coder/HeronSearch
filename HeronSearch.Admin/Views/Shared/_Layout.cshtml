@* Admin_Layout: the signed-in shell with the top bar, sidebar, main content, and footer. *@
@inject IConfiguration Configuration
@{
    // Logo path (same fallback as _TopBar) used as the page icon.
    var logoPath = Configuration["Branding:LogoPath"];
    if (string.IsNullOrWhiteSpace(logoPath) || !logoPath.StartsWith("/") || logoPath.StartsWith("//"))
    {
        logoPath = "/images/heronsearch-logo.svg";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HeronSearch</title>
    <link rel="icon" href="@logoPath" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hs-body">
    <a class="visually-hidden-focusable hs-skip-link" href="#main-content">Skip to main content</a>
    <partial name="_TopBar" />
    <div class="hs-shell">
        <partial name="_Sidebar" />
        <main id="main-content" class="hs-main" tabindex="-1">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
    <partial name="_Footer" />
    <partial name="_ConfirmModal" />
    <partial name="_LogoutModal" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
