@* My Reports: the signed-in student's own items (all statuses), newest first, as a table with a photo, type,
   status badge, date, and a link to Details. 10 per page with the shared pager. *@
@model StudentReportListViewModel
@{
    ViewData["Title"] = "My Reports";
    Layout = "_StudentLayout";
}
<div class="student-container">
    <div class="dash-header">
        <h1>My Reports</h1>
        <p>Items you have reported, newest first.</p>
    </div>

    <section class="dash-section">
        @if (Model.Rows.Count == 0)
        {
            <div class="hs-card">
                <partial name="_EmptyState" model="@(("bi-box-seam", "You have not reported any items yet.", (string?)"Report an item", (string?)"/Student/ReportLost"))" />
            </div>
        }
        else
        {
            <div class="hs-card">
                <div class="table-responsive">
                    <table class="table hs-table">
                        <thead>
                            <tr>
                                <th scope="col">Item</th>
                                <th scope="col">Type</th>
                                <th scope="col">Status</th>
                                <th scope="col">Date</th>
                                <th scope="col"><span class="visually-hidden">Action</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <partial name="_ItemPhoto" model="@((row.ImagePath, row.Category, "sm"))" />
                                            <span>@row.Name</span>
                                        </div>
                                    </td>
                                    <td><span class="hs-chip">@row.Type</span></td>
                                    <td><partial name="_StatusBadge" model="@row.Status.ToString()" /></td>
                                    <td>@DisplayFormat.ShortDate(row.DateReported)</td>
                                    <td class="text-end">
                                        @if (row.Status == ItemStatus.Active)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Student" asp-action="Details" asp-route-id="@row.Id">
                                                View<span class="visually-hidden"> @row.Name</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <partial name="_Pager" model="Model.Pager" />
                </div>
            </div>
        }
    </section>
</div>
